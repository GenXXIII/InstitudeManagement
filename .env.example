# Never commit the real .env file.
COMPOSE_PROJECT_NAME=YOUR_dOCKER_NAME

# On a fresh install, set both values to the same strong password.
# On an older database, bootstrap is the current sa password and SQL_PASSWORD is the new one.
SQL_PASSWORD=YOUR_STRONG_SQL_RUNTIME_PASSWORD
SQL_BOOTSTRAP_PASSWORD=YOUR_CURRENT_OR_INITIAL_STRONG_SQL_PASSWORD
SQL_DATABASE=YOUR_DATABASE_NAME
SQL_PORT=1433

API_PORT=YOUR_API_PORT
WEB_PORT=YOUR_WEB_PORT
NEXT_PUBLIC_API_URL=YOUR_URL_WEB_API

# Server-side only. Never prefix this with NEXT_PUBLIC_ or EXPO_PUBLIC_.
BAKONG_API_TOKEN=YOUR_BAKONG_API_TOKEN
